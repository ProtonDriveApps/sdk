{
    "name": "proton-drive-cli",
    "private": true,
    "version": "0.0.1",
    "main": "dist/main.js",
    "scripts": {
        "build": "bun ./scripts/build-cli.mjs",
        "build:bundle": "bun ./scripts/build-cli.mjs --bundle-only",
        "check-types": "tsc --noEmit",
        "generate-metric-schemas": "bun ./scripts/generate-metric-schemas.ts",
        "lint": "eslint src --ext .ts --cache --ignore-pattern '**/api/*-types.ts'",
        "pretty": "prettier --write $(find src -type f -name '*.ts')",
        "test": "node node_modules/jest/bin/jest.js src",
        "test:ci": "node node_modules/jest/bin/jest.js src --runInBand --no-cache",
        "test:watch": "node node_modules/jest/bin/jest.js src --watch --coverage=false"
    },
    "devDependencies": {
        "@swc/core": "^1.12.3",
        "@swc/jest": "^0.2.38",
        "@types/bun": "^1.3.14",
        "@types/jest": "^29.5.14",
        "@types/sharedworker": "^0.0.130",
        "@typescript-eslint/eslint-plugin": "^8.55.0",
        "bun-types": "^1.3.14",
        "eslint": "^8.57.1",
        "eslint-plugin-simple-import-sort": "^13.0.0",
        "eslint-plugin-tsdoc": "^0.3.0",
        "jest": "^29.7.0",
        "json-schema-to-typescript": "^13.1.2",
        "openapi-typescript": "^7.4.1",
        "prettier": "^3.6.2",
        "typescript": "^5.9.3"
    },
    "overrides": {
        "@xmldom/xmldom": "^0.9.12",
        "brace-expansion@1": "1.1.18",
        "brace-expansion@2": "2.1.4",
        "brace-expansion@5": "^5.0.9",
        "tmp": "^0.2.7"
    },
    "dependencies": {
        "@noble/hashes": "^1.8.0",
        "@protontech/crypto": "2.0.0",
        "@protontech/drive-sdk": "file:../client/js",
        "@sentry/bun": "^10.73.0",
        "ky": "^1.14.3",
        "proton-drive-sdk-account": "file:../incubating/account/js",
        "ttag": "^1.8.7"
    },
    "patchedDependencies": {
        "@protontech/crypto@2.0.0": "../config/js/patches/@protontech%2Fcrypto@2.0.0.patch"
    }
}
