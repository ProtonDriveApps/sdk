<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>

    <!-- Without this property, building with AOT for some platforms will fail -->
    <PublishAotUsingRuntimePack>true</PublishAotUsingRuntimePack>

    <Product>Proton Drive</Product>
    <Authors>Proton AG</Authors>
    <Company>Proton AG</Company>
    <Version>0.0.1</Version>
    <Copyright>© 2025 Proton AG</Copyright>
    <Description>Proton Drive</Description>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NeutralLanguage>en</NeutralLanguage>
    <Deterministic>true</Deterministic>
    <Configurations>Debug;Release;DebugWithSearch;ReleaseWithSearch</Configurations>
    <TreatWarningsAsErrors Condition="'$(Configuration)' == 'Release' or '$(Configuration)' == 'ReleaseWithSearch'">true</TreatWarningsAsErrors>

    <NativeLibPrefix Condition="!$(RuntimeIdentifier.StartsWith('win'))">lib</NativeLibPrefix>
  </PropertyGroup>

  <!--
    NuGet lock files (packages.lock.json) pin every transitive package of the rust crypto backend. The
    go backend has none until it is removed: its Proton.Cryptography version differs, and its restores
    (the default, CryptoBackend unset) use no lock file. The release SBOMs are read from them
    (internal/ci/just/client-cs.just, `sbom`). Publishing and restores for a runtime identifier
    (dotnet publish, restore -r) use none either: some package references depend on the runtime
    identifier, and a lock file per runtime would be rewritten by every platform build. Those
    restores point NuGet at a lock file that never exists: NuGet uses any packages.lock.json it
    finds, and fails (NU1005) when one exists while RestorePackagesWithLockFile is false. Without
    UseDefaultPublishRuntimeIdentifier=false, the SDK would add the host's runtime to the restore of
    AOT executables (the CLI), and the lock files would differ between Linux and macOS. CI restores in
    locked mode, so a lock file that no longer matches the projects fails the pipeline; a local
    restore of the rust backend (-p:CryptoBackend=rust) updates it.
  -->
  <PropertyGroup>
    <_ProtonUseLockFile>false</_ProtonUseLockFile>
    <_ProtonUseLockFile Condition="'$(CryptoBackend)' == 'rust' and '$(RuntimeIdentifier)' == '' and '$(RuntimeIdentifiers)' == '' and '$(_IsPublishing)' != 'true'">true</_ProtonUseLockFile>
    <RestorePackagesWithLockFile>$(_ProtonUseLockFile)</RestorePackagesWithLockFile>
    <NuGetLockFilePath Condition="'$(_ProtonUseLockFile)' != 'true'">obj/packages.unused.lock.json</NuGetLockFilePath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(_ProtonUseLockFile)' == 'true'">
    <UseDefaultPublishRuntimeIdentifier>false</UseDefaultPublishRuntimeIdentifier>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
  </PropertyGroup>

  <!-- Release packs embed the package's SBOM (internal/ci/just/client-cs.just, `pack` and `sbom`). -->
  <ItemGroup Condition="'$(SbomDirectory)' != '' and '$(IsPackable)' == 'true'">
    <None Include="$(SbomDirectory)/$(MSBuildProjectName).cdx.json" Pack="true" PackagePath="sbom/bom.cdx.json" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <GlobalAnalyzerConfigFiles Include="$(MSBuildThisFileDirectory).globalconfig" />
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug' or '$(Configuration)' == 'DebugWithSearch'">
    <DebugType>embedded</DebugType>
    <EmbedAllSources>true</EmbedAllSources>
  </PropertyGroup>

  <PropertyGroup Condition="!$(MSBuildProjectName.EndsWith('.Tests'))">
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Roslynator.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <PackageReference Include="Roslynator.Formatting.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <PackageReference Include="SonarAnalyzer.CSharp">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <PackageReference Include="StyleCop.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Condition="!$(MSBuildProjectName.EndsWith('.Tests'))">
    <InternalsVisibleTo Include="$(MSBuildProjectName).Tests" />
    <InternalsVisibleTo Include="$(MSBuildProjectName).CExports.Tests" Condition="!$(MSBuildProjectName.EndsWith('CExports'))" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="NSubstitute.Analyzers.CSharp">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="xunit.v3.mtp-v2" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />

    <Using Include="Xunit" />
    <Using Include="AwesomeAssertions" />
    <Using Include="NSubstitute" />
  </ItemGroup>

  <PropertyGroup>
    <IncludeProtonDriveSearch Condition="'$(IncludeProtonDriveSearch)' == '' and $(Configuration.EndsWith('WithSearch'))">true</IncludeProtonDriveSearch>
    <IncludeProtonDriveSearch Condition="'$(IncludeProtonDriveSearch)' == ''">false</IncludeProtonDriveSearch>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IncludeProtonDriveSearch)' == 'true'">
    <DefineConstants>$(DefineConstants);PROTON_DRIVE_SEARCH</DefineConstants>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)ProjectReferenceRuntimes.targets" />

</Project>
