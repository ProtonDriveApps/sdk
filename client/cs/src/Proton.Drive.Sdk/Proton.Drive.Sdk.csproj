<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageTags>Cloud Storage Volume Folder File</PackageTags>
    <Description>Provides the means to interact with the Proton Drive services.</Description>
    <EmbedAllSources>true</EmbedAllSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(EnableTransferStorageBuffer)' == 'true'">
    <DefineConstants>$(DefineConstants);TRANSFER_STORAGE_BUFFER_ENABLED</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(IncludeProtonDriveSearch)' != 'true'">
    <Compile Remove="Search/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.IO.RecyclableMemoryStream" />
    <PackageReference Include="Polly" />
    <PackageReference Include="System.Numerics.Tensors" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Proton.Drive.Sdk.CExports" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Proton.Sdk\Proton.Sdk.csproj" />
  </ItemGroup>

  <Import Project="Search.targets" Condition="'$(IncludeProtonDriveSearch)' == 'true'" />

</Project>
