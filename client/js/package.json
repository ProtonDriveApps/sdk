{
    "name": "@protontech/drive-sdk",
    "version": "0.0.1",
    "description": "Proton Drive SDK",
    "license": "MIT",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist",
        "src"
    ],
    "scripts": {
        "build": "npm run search-bindings -- --optional && tsc --emitDeclarationOnly && swc src -d dist --strip-leading-paths --ignore 'src/search/vendor/**,**/*.d.ts' && npm run copy-search-vendor-to-dist",
        "build:ci": "npm run search-bindings -- --optional && rm -rf dist tsconfig.tsbuildinfo && tsc --emitDeclarationOnly && swc src -d dist --strip-leading-paths --ignore 'src/search/vendor/**,**/*.d.ts' && npm run copy-search-vendor-to-dist",
        "copy-search-vendor-to-dist": "node tasks/search/copy-search-vendor-to-dist.mjs",
        "check-types": "tsc --noEmit",
        "generate-docs": "typedoc src/protonDriveClient.ts src/protonDrivePhotosClient.ts src/protonDrivePublicLinkClient.ts src/index.ts --out ${OUTPUT_PATH}",
        "generate-types": "openapi-typescript ../../api/openapi-drive.json -o ./src/internal/apiService/driveTypes.ts && openapi-typescript ../../api/openapi-core.json -o ./src/internal/apiService/coreTypes.ts",
        "search-bindings": "node tasks/search/search-bindings.mjs",
        "lint": "eslint src --ext .ts --cache --ignore-pattern '**/apiService/*Types.ts' --ignore-pattern 'src/search/vendor/**'",
        "pretty": "prettier --write  $(find src -type f -name '*.ts')",
        "test": "node node_modules/jest/bin/jest.js",
        "test:ci": "node node_modules/jest/bin/jest.js --runInBand --no-cache",
        "test:watch": "node node_modules/jest/bin/jest.js --watch --coverage=false",
        "lint:ttag": "node tasks/linter.mjs src --verbose",
        "extract:ttag": "ttag extract src --output po/template.pot"
    },
    "dependencies": {
        "@boltffi/runtime": "0.31.0",
        "@noble/hashes": "^1.8.0",
        "comlink": "^4.4.2",
        "ttag": "^1.8.7"
    },
    "optionalDependencies": {
        "@xmldom/xmldom": "^0.9.12",
        "exifreader": "^4.44.0"
    },
    "devDependencies": {
        "@protontech/crypto": "^2.0.0",
        "@protontech/global-types": "^1.0.0",
        "@swc/cli": "^0.8.1",
        "@swc/core": "^1.12.3",
        "@swc/jest": "^0.2.38",
        "@types/jest": "^29.5.14",
        "@types/node": "^22.20.4",
        "@typescript-eslint/eslint-plugin": "^8.58.1",
        "eslint": "^8.57.1",
        "eslint-plugin-simple-import-sort": "^13.0.0",
        "eslint-plugin-tsdoc": "^0.3.0",
        "glob": "^11.1.0",
        "jest": "^29.7.0",
        "openapi-typescript": "^7.4.1",
        "prettier": "^3.6.2",
        "ttag-cli": "^1.12.0",
        "typedoc": "^0.28.20",
        "typescript": "^5.9.3"
    },
    "peerDependencies": {
        "@protontech/crypto": "^2.0.0"
    }
}
